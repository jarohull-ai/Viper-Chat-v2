[Unit]
Description=Viper SEED IPC v2 provider
Documentation=https://github.com/jarohull-ai/Viper-Chat-v2/blob/main/docs/v2/DEPLOYMENT.md
After=local-fs.target

[Service]
Type=simple
User=viper-seed
Group=viper-ipc
RuntimeDirectory=viper-seed
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
LoadCredential=seed_key:/var/lib/viper-seed/credentials/signing-key
ExecStart=/bin/sh -ec 'exec /usr/local/bin/viper-seed-provider --runtime-dir /run/viper-seed --socket /run/viper-seed/seed.sock --client-uid 990 --credential-fd 3 3<"%d/seed_key"'
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
